\section{The OLS Algebraic Identity Theorem}
\label{sec:ols_identity}
% =============================================================================

The comparison in Section~8 between Direct LP and Aggregate-Shock LP
suggests that the two approaches should produce different IRF estimates
because of the structural factorisation $\Gamma_h = A_h\Omega$.
However, we now establish a surprising \emph{negative} result:
under OLS estimation with a known, full-rank $\Omega$, the two approaches
are \textbf{algebraically identical} in \emph{every finite sample}.

\subsection{Setup}

Define the two sets of regressors:
\begin{itemize}
  \item \textbf{Direct LP}: regress $\mathbf{y}_{t+h}$ on the structural
        shock vector $\bm{\varepsilon}_t$.  Stacking over $t$, let
        $E = [\bm{\varepsilon}_1,\ldots,\bm{\varepsilon}_T]' \in\R^{T\times K}$.
  \item \textbf{Aggregate LP}: regress $\mathbf{y}_{t+h}$ on the aggregate
        shock vector $\mathbf{s}_t = \Omega\bm{\varepsilon}_t$.  Stacking,
        $S = E\,\Omega' \in\R^{T\times K}$.
\end{itemize}

\subsection{Theorem: OLS Algebraic Identity}

\begin{keybox}[Theorem (OLS Identity)]
\begin{proposition}[OLS Algebraic Identity]\label{prop:ols_identity}
For any invertible $K\times K$ matrix $\Omega$, the Direct OLS and
Aggregate OLS estimators produce \textbf{exactly the same} structural
IRFs in every sample:
\begin{equation}\label{eq:ols_identity}
  \boxed{\hat{\Gamma}_h^{\mathrm{OLS}}
  \;=\;
  \hat{A}_h^{\mathrm{OLS}}\;\Omega
  \qquad \text{exactly, in every sample, for all } h.}
\end{equation}
\end{proposition}
\end{keybox}

\begin{proof}
The OLS estimators are:
\begin{align}
  \hat{\Gamma}_h^{\mathrm{OLS}} &= (E'E)^{-1}E'\mathbf{Y}_{+h},
  \label{eq:gamma_ols}\\[6pt]
  \hat{A}_h^{\mathrm{OLS}} &= (S'S)^{-1}S'\mathbf{Y}_{+h}.
  \label{eq:a_ols}
\end{align}
Substituting $S = E\Omega'$:
\begin{align}
  S'S &= \Omega E'E\Omega', \label{eq:STS}\\
  S'\mathbf{Y}_{+h} &= \Omega E'\mathbf{Y}_{+h}. \label{eq:STY}
\end{align}
Therefore:
\begin{align}
  \hat{A}_h^{\mathrm{OLS}}
  &= (\Omega E'E\Omega')^{-1}\,\Omega\, E'\mathbf{Y}_{+h} \nonumber\\
  &= (\Omega')^{-1}(E'E)^{-1}\Omega^{-1}\,\Omega\, E'\mathbf{Y}_{+h} \nonumber\\
  &= (\Omega')^{-1}\underbrace{(E'E)^{-1} E'\mathbf{Y}_{+h}}_{=\;\hat{\Gamma}_h^{\mathrm{OLS}}}.
  \label{eq:a_cancel}
\end{align}
So $\hat{A}_h^{\mathrm{OLS}} = (\Omega')^{-1}\hat{\Gamma}_h^{\mathrm{OLS}}$,
and multiplying both sides on the left by $\Omega'$:
\begin{equation}
  \hat{A}_h^{\mathrm{OLS}}\;\Omega
  = (\Omega')^{-1}\hat{\Gamma}_h^{\mathrm{OLS}}\;\Omega
  \;\;\xrightarrow{\text{right-multiply}}\;\;
  \hat{\Gamma}_h^{\mathrm{OLS}} = \hat{A}_h^{\mathrm{OLS}}\;\Omega.
  \qedhere
\end{equation}
\end{proof}

\begin{remark}[Interpretation]
This identity is \textbf{not} a finite-sample coincidence---it is an
algebraic tautology.  It arises because OLS is
\emph{equivariant to invertible linear transformations} of the
regressors.  Reparameterising $\bm{\varepsilon}\to\Omega\bm{\varepsilon}$
merely rotates and scales the coefficient space; OLS undoes this
transformation automatically.
\end{remark}

\begin{remark}[Misspecified $\Omega$]
The identity holds for \emph{any} invertible $\Omega$, even a ``wrong'' one.
If the researcher uses $\tilde{\Omega}\neq\Omega_{\mathrm{true}}$
(with $\tilde{\Omega}$ still invertible), defines
$\tilde{S}=E\tilde{\Omega}'$, and converts back via
$\hat{A}_h^{\mathrm{OLS}}\tilde{\Omega}$, the result is still
$\hat{\Gamma}_h^{\mathrm{OLS}}$.  OLS \emph{cannot distinguish} between
parameterisations.
\end{remark}

\subsection{Implication: OLS Cannot Distinguish Parameterisations}

The OLS identity has a stark consequence:

\begin{keybox}[Consequence of OLS Identity]
Under OLS estimation with a known, invertible $\Omega$, the Aggregate-Shock LP
is \textbf{observationally identical} to the Direct LP.  The structural
decomposition $\Gamma_h = A_h\Omega$ provides no empirically testable
content beyond what Direct LP already delivers.  To obtain genuinely
different estimates, one must either:
\begin{enumerate}
  \item Use a penalised/regularised estimator (Ridge, LASSO, Bayesian),
  \item Reduce the dimension of $\Omega$ ($r < K$), or
  \item Impose cross-horizon restrictions on $A_h$.
\end{enumerate}
\end{keybox}


% =============================================================================
\section{Breaking the Identity: Ridge Regression}
\label{sec:ridge}
% =============================================================================

We now show that \textbf{Ridge regression} ($L_2$ penalty) generically
breaks the OLS identity, producing genuinely different IRF estimates
from the two parameterisations.

\subsection{Ridge LP Estimators}

Add a penalty $\lambda\|\beta\|_2^2$ to the OLS objective.  The
estimators become:

\begin{align}
  \hat{\Gamma}_h^{\mathrm{Ridge}}
  &= \bigl(E'E + \lambda I_K\bigr)^{-1}E'\mathbf{Y}_{+h},
  \label{eq:gamma_ridge}\\[6pt]
  \hat{A}_h^{\mathrm{Ridge}}
  &= \bigl(S'S + \lambda I_K\bigr)^{-1}S'\mathbf{Y}_{+h}.
  \label{eq:a_ridge}
\end{align}

\noindent Define $M \equiv E'E$ (the Gram matrix of structural shocks).

\subsection{Theorem: Ridge Divergence}

\begin{keybox}[Theorem (Ridge Breaks Identity)]
\begin{proposition}[Ridge Divergence]\label{prop:ridge}
Under Ridge estimation ($\lambda > 0$), the structural IRFs from the
two parameterisations satisfy
\begin{equation}\label{eq:ridge_neq}
  \hat{A}_h^{\mathrm{Ridge}}\;\Omega
  \;=\;
  \hat{\Gamma}_h^{\mathrm{Ridge}}
  \quad\Longleftrightarrow\quad
  \Omega\Omega' = I_K
  \quad\text{($\Omega$ orthogonal)}.
\end{equation}
For any non-orthogonal $\Omega$ (i.e., $\Omega\Omega'\neq I$), the two
IRFs are \textbf{generically different}.
\end{proposition}
\end{keybox}

\begin{proof}
Substituting $S = E\Omega'$ into~\eqref{eq:a_ridge}:
\begin{align}
  \hat{A}_h^{\mathrm{Ridge}}
  &= \bigl(\Omega\,M\,\Omega' + \lambda I\bigr)^{-1}\,\Omega\, E'\mathbf{Y}_{+h}.
  \label{eq:a_ridge_expand}
\end{align}
For the identity $\hat{A}_h^{\mathrm{Ridge}}\Omega = \hat{\Gamma}_h^{\mathrm{Ridge}}$
to hold, we need:
\begin{equation}\label{eq:ridge_condition}
  \Omega'\bigl(\Omega\,M\,\Omega' + \lambda I\bigr)^{-1}\Omega
  \;=\;
  (M + \lambda I)^{-1}.
\end{equation}
Rearranging via Woodbury-style arguments, this requires:
\begin{equation}
  \Omega M\Omega' + \lambda I
  = \Omega(M + \lambda I)\Omega'
  \quad\Longleftrightarrow\quad
  \lambda I = \lambda\,\Omega\Omega'.
\end{equation}
This holds if and only if $\Omega\Omega' = I_K$, i.e., $\Omega$ is orthogonal.
\end{proof}

\subsection{Intuition: Why Ridge Breaks the Identity}

\begin{keybox}[Intuition]
The Ridge penalty $\lambda\|\beta\|_2^2$ shrinks coefficients toward
\textbf{zero}.  But ``zero'' in the structural space ($\Gamma_h = 0$) and
``zero'' in the aggregate space ($A_h = 0$) represent different economic
hypotheses when $\Omega$ is not orthogonal.

\begin{itemize}
  \item \textbf{Direct Ridge} shrinks each $\gamma_{ik}^{(h)}$ toward zero,
        penalising the structural coefficient magnitudes equally.
  \item \textbf{Aggregate Ridge} shrinks each $a_{ij}^{(h)}$ toward zero,
        penalising the aggregate coefficient magnitudes equally.  When
        converted back via $\hat{A}_h\Omega$, the effective penalty on
        structural coefficients is $\lambda\|\beta\|_{\Omega\Omega'}^2$
        (a \emph{weighted} norm), not $\lambda\|\beta\|_2^2$.
\end{itemize}

\noindent The two penalties coincide only when $\Omega\Omega' = I$ (orthogonal),
making the two norms identical.  For non-orthogonal $\Omega$, they
impose different shrinkage directions, yielding different estimates.
\end{keybox}



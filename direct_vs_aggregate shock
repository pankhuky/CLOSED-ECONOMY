% ─────────────────────────────────────────────
\subsection{Equivalence and the Key Restriction}
% ─────────────────────────────────────────────

\begin{proposition}[Observational Equivalence and the Rank Restriction]
\label{prop:equiv}
The two models produce the same fitted values if and only if
\begin{equation}\label{eq:equiv}
  \Gamma_h = A_h\,\Omega \qquad \forall\, h.
\end{equation}
This factorisation imposes a \textbf{rank restriction}: the IRF matrix $\Gamma_h$
must lie in the column space of $\Omega^{\top}$ for every horizon $h$.
If $\Omega$ is unrestricted (full rank), eq.~\eqref{eq:equiv} holds
trivially (set $A_h=\Gamma_h\Omega^{-1}$) and the models are
observationally equivalent.  The restriction becomes binding only when
$\Omega$ is estimated with cross-horizon constraints (e.g., $\Omega$ is
the same PCA loading matrix for all $h$).
\end{proposition}

\begin{remark}
The practical implication is important:
\begin{itemize}
  \item \textbf{Direct LP}: estimates $10\times H$ free parameters
        ($\Gamma_h$ at each of $H$ horizons) --- one regression per cell.
  \item \textbf{Aggregate LP}: estimates $10\times H$ parameters in $A_h$
        \emph{plus} $25$ parameters in $\Omega$, but $\Omega$ is
        \textbf{shared across all horizons}.  For large $H$, this cross-horizon
        pooling is a powerful regularisation that reduces variance at the cost
        of imposing structural factorisation.
\end{itemize}
\end{remark}


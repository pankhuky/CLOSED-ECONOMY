\section{The Five Structural Shocks: Shock Vector $\bm{\varepsilon}_t$}
% =============================================================================

We observe five distinct structural shocks at each time $t$:

\begin{center}
\begin{tabular}{clll}
\toprule
$k$ & \textbf{Shock} & \textbf{Symbol} & \textbf{Economic content} \\
\midrule
1 & Fiscal Policy         & $\varepsilon_{t}^{\mathrm{FP}}$     & Government spending / tax shocks \\
2 & Monetary Policy       & $\varepsilon_{t}^{\mathrm{MP}}$     & Unexpected interest-rate changes  \\
3 & Technology (TFP)      & $\varepsilon_{t}^{\mathrm{TFP}}$    & Total factor productivity shocks  \\
4 & Oil Price             & $\varepsilon_{t}^{\mathrm{Oil}}$    & Commodity supply disturbances     \\
5 & Financial Crisis      & $\varepsilon_{t}^{\mathrm{Crisis}}$ & Rare, large financial disruptions \\
\bottomrule
\end{tabular}
\end{center}

\bigskip
\noindent Stack the five shocks into a \textbf{$5\times 1$ shock vector}:

\begin{keybox}[Shock Vector]
\begin{equation}\label{eq:shock_vec}
  \bm{\varepsilon}_{t}
  \;=\;
  \begin{pmatrix}
    \varepsilon_{t}^{\mathrm{FP}}     \\[4pt]
    \varepsilon_{t}^{\mathrm{MP}}     \\[4pt]
    \varepsilon_{t}^{\mathrm{TFP}}    \\[4pt]
    \varepsilon_{t}^{\mathrm{Oil}}    \\[4pt]
    \varepsilon_{t}^{\mathrm{Crisis}}
  \end{pmatrix}
  \;\in\;\R^{5\times 1}.
\end{equation}
\end{keybox}

% =============================================================================
\section{The Aggregate Shock Vector: $\aggr_t = \Omega\,\bm{\varepsilon}_t$}
% =============================================================================

The five individual shocks are combined through a
\textbf{$5\times 5$ weight matrix} $\Omega$ to produce a
\textbf{$5\times 1$ aggregate shock vector} $\aggr_t$:

\begin{keybox}[Aggregate Shock]
\begin{equation}\label{eq:aggr_def}
  \underbrace{\aggr_{t}}_{5\times 1}
  \;=\;
  \underbrace{\Omega}_{5\times 5}
  \;\underbrace{\bm{\varepsilon}_{t}}_{5\times 1}
\end{equation}
\end{keybox}

\subsection{The Weight Matrix $\Omega$ (5\texttimes 5)}

Each \emph{row} of $\Omega$ defines how one component of the aggregate
shock is constructed from the five structural shocks:

\begin{equation}\label{eq:Omega}
  \Omega
  =
  \begin{pmatrix}
    \omega_{11} & \omega_{12} & \omega_{13} & \omega_{14} & \omega_{15}\\[4pt]
    \omega_{21} & \omega_{22} & \omega_{23} & \omega_{24} & \omega_{25}\\[4pt]
    \omega_{31} & \omega_{32} & \omega_{33} & \omega_{34} & \omega_{35}\\[4pt]
    \omega_{41} & \omega_{42} & \omega_{43} & \omega_{44} & \omega_{45}\\[4pt]
    \omega_{51} & \omega_{52} & \omega_{53} & \omega_{54} & \omega_{55}
  \end{pmatrix}
  \;\in\;\R^{5\times 5}.
\end{equation}

\noindent The $(i,k)$ entry $\omega_{ik}$ is the weight that the
$i$-th aggregate component places on the $k$-th structural shock
$\varepsilon_{t}^{k}$.

\subsection{Expanded Form}

Writing out equation~\eqref{eq:aggr_def} element by element, the
$i$-th component of $\aggr_{t}$ is:

\begin{equation}\label{eq:aggr_row}
  [\aggr_{t}]_{i}
  = \sum_{k=1}^{5} \omega_{ik}\,\varepsilon_{t}^{k}
  = \omega_{i1}\,\varepsilon_{t}^{\mathrm{FP}}
  + \omega_{i2}\,\varepsilon_{t}^{\mathrm{MP}}
  + \omega_{i3}\,\varepsilon_{t}^{\mathrm{TFP}}
  + \omega_{i4}\,\varepsilon_{t}^{\mathrm{Oil}}
  + \omega_{i5}\,\varepsilon_{t}^{\mathrm{Crisis}},
  \quad i=1,\ldots,5.
\end{equation}

\subsection{Covariance Structure of $\aggr_t$}

Let $\Sigma_{\varepsilon} = \E[\bm{\varepsilon}_{t}\bm{\varepsilon}_{t}^{\top}]$
be the $5\times 5$ covariance matrix of the structural shocks.
The covariance matrix of the aggregate shock vector is:
\begin{equation}\label{eq:cov_aggr}
  \Sigma_{\aggr}
  = \E\!\left[\aggr_{t}\,\aggr_{t}^{\top}\right]
  = \Omega\,\Sigma_{\varepsilon}\,\Omega^{\top}
  \;\in\;\R^{5\times 5}.
\end{equation}

\begin{itemize}
  \item If the structural shocks are orthonormal,
        $\Sigma_{\varepsilon}=I_{5}$, then
        $\Sigma_{\aggr}=\Omega\Omega^{\top}$.
  \item If additionally $\Omega$ is orthogonal ($\Omega\Omega^{\top}=I$),
        the components of $\aggr_{t}$ are uncorrelated with unit
        variance---analogous to PCA.
\end{itemize}

% =============================================================================
\section{Output Equation: $\mathbf{Y}_t = A_t\,\aggr_t$}
% =============================================================================

\subsection{Outcome Vector $\mathbf{Y}_t$ (2\texttimes 1)}

We focus on two macroeconomic outcomes:

\begin{equation}\label{eq:Y_def}
  \mathbf{Y}_{t}
  =
  \begin{pmatrix} y_{1,t} \\[4pt] y_{2,t} \end{pmatrix}
  =
  \begin{pmatrix}
    \log\mathrm{IP}_{t}\\[4pt] u_{t}
  \end{pmatrix}
  \;\in\;\R^{2\times 1},
\end{equation}

where $\log\mathrm{IP}_{t}$ is log Industrial Production and $u_{t}$ is
the unemployment rate.

\subsection{Response Matrix $A_t$ (2\texttimes 5)}

The $2\times 5$ matrix $A_t$ maps the five-dimensional aggregate shock
vector to the two outcome variables:

\begin{equation}\label{eq:A_mat}
  A_t
  =
  \begin{pmatrix}
    a_{11} & a_{12} & a_{13} & a_{14} & a_{15}\\[4pt]
    a_{21} & a_{22} & a_{23} & a_{24} & a_{25}
  \end{pmatrix}
  \;\in\;\R^{2\times 5}.
\end{equation}

\noindent The entry $a_{ij}$ captures how the $j$-th aggregate component
affects outcome $y_{i}$:
\begin{itemize}
  \item \textbf{Row 1} ($a_{1,\cdot}$): response of $\log\mathrm{IP}$ to each
        aggregate component.
  \item \textbf{Row 2} ($a_{2,\cdot}$): response of unemployment $u$ to each
        aggregate component.
\end{itemize}

\subsection{The Linear Output Model}

\begin{keybox}[Output Equation]
\begin{equation}\label{eq:output}
  \underbrace{\mathbf{Y}_{t}}_{2\times 1}
  \;=\;
  \underbrace{A_t}_{2\times 5}
  \;\underbrace{\aggr_{t}}_{5\times 1}
  \;+\;
  \underbrace{\bm{\omega}_{t}}_{2\times 1}
\end{equation}
\end{keybox}

\noindent where $\bm{\omega}_{t}$ is a $2\times 1$ vector of idiosyncratic
errors orthogonal to $\aggr_t$.

\subsection{Full Matrix Expansion}

Substituting $\aggr_{t}=\Omega\,\bm{\varepsilon}_{t}$
into \eqref{eq:output}:

\begin{equation}\label{eq:output_full}
  \underbrace{\mathbf{Y}_{t}}_{2\times 1}
  \;=\;
  \underbrace{A_t}_{2\times 5}
  \;\underbrace{\Omega}_{5\times 5}
  \;\underbrace{\bm{\varepsilon}_{t}}_{5\times 1}
  \;+\;
  \bm{\omega}_{t}
\end{equation}

Written in explicit matrix-vector form:

\begin{equation}\label{eq:output_explicit}
  \begin{pmatrix} y_{1,t}\\[4pt] y_{2,t} \end{pmatrix}
  =
  \begin{pmatrix}
    a_{11} & a_{12} & a_{13} & a_{14} & a_{15}\\[4pt]
    a_{21} & a_{22} & a_{23} & a_{24} & a_{25}
  \end{pmatrix}
  \begin{pmatrix}
    \omega_{11} & \omega_{12} & \omega_{13} & \omega_{14} & \omega_{15}\\[4pt]
    \omega_{21} & \omega_{22} & \omega_{23} & \omega_{24} & \omega_{25}\\[4pt]
    \omega_{31} & \omega_{32} & \omega_{33} & \omega_{34} & \omega_{35}\\[4pt]
    \omega_{41} & \omega_{42} & \omega_{43} & \omega_{44} & \omega_{45}\\[4pt]
    \omega_{51} & \omega_{52} & \omega_{53} & \omega_{54} & \omega_{55}
  \end{pmatrix}
  \begin{pmatrix}
    \varepsilon_{t}^{\mathrm{FP}}\\[4pt]
    \varepsilon_{t}^{\mathrm{MP}}\\[4pt]
    \varepsilon_{t}^{\mathrm{TFP}}\\[4pt]
    \varepsilon_{t}^{\mathrm{Oil}}\\[4pt]
    \varepsilon_{t}^{\mathrm{Crisis}}
  \end{pmatrix}
  +
  \begin{pmatrix}\omega_{1,t}\\[4pt]\omega_{2,t}\end{pmatrix}
\end{equation}

\subsection{Reduced-Form Mapping}

Define the \textbf{reduced-form response matrix}:
\begin{equation}\label{eq:B_reduced}
  B_t
  \;\equiv\;
  A_t\,\Omega
  \;\in\;\R^{2\times 5}.
\end{equation}

Then the model simplifies to:
\begin{equation}\label{eq:output_reduced}
  \mathbf{Y}_{t}
  = B_t\,\bm{\varepsilon}_{t} + \bm{\omega}_{t},
\end{equation}
where the $(i,k)$ entry of $B_t$, denoted $b_{ik}$, is the
\textbf{total effect} of structural shock $k$ on outcome $y_{i}$:

\begin{equation}\label{eq:bik}
  b_{ik}
  = \sum_{j=1}^{5} a_{ij}\,\omega_{jk},
  \qquad i=1,2,\quad k=1,\ldots,5.
\end{equation}


% ─────────────────────────────────────────────
\subsection{Summary: Why Aggregate LP Dominates Direct LP}
% ─────────────────────────────────────────────

\begin{keybox}[Three Advantages of Aggregate-Shock LP over Direct LP]
\begin{enumerate}
  \item \textbf{Structural transparency}: The IRF $= A_h\Omega$ separates
        \emph{how shocks mix into channels} ($\Omega$, fixed) from
        \emph{how channels propagate to outcomes over time} ($A_h$, horizon-varying).
        Direct LP cannot make this distinction.

  \item \textbf{Cross-horizon efficiency}: $\Omega$ is estimated once from
        the full sample and pooled across all $H$ horizons, reducing
        estimation uncertainty at long horizons where LP is known to be
        imprecise.

  \item \textbf{Economic interpretability}: Every IRF entry decomposes into
        five labelled transmission channels.  Policy analysis can target
        specific channels (e.g., ``how much of the crisis effect on unemployment
        runs through the fiscal policy channel?'') instead of reading a single
        black-box coefficient.
\end{enumerate}
\end{keybox}


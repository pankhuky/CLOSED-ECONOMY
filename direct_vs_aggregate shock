\section{Comparison: Direct LP vs.\ Aggregate-Shock LP}
% =============================================================================

\subsection{The Direct LP Model}

The standard approach in the empirical literature enters each structural
shock \emph{directly} as a separate regressor, without any aggregation step:

\begin{keybox}[Direct LP at Horizon $h$]
\begin{equation}\label{eq:direct_LP}
  \underbrace{\mathbf{Y}_{t+h}-\mathbf{Y}_{t-1}}_{2\times1}
  =
  \bm{\mu}_h
  +
  \underbrace{\Gamma_h}_{2\times5}
  \underbrace{\bm{\varepsilon}_t}_{5\times1}
  +
  \underbrace{\mathbf{v}_{t+h}}_{2\times1},
  \qquad h=0,1,\ldots,H
\end{equation}
\end{keybox}

\noindent where $\Gamma_h \in \R^{2\times5}$ is the \textbf{direct response matrix}
estimated separately at each horizon $h$.  The $(i,k)$ entry $\gamma_{ik}^{(h)}$
is estimated as a single OLS coefficient with no further structure imposed.

\subsection{Direct LP IRF: Full Expansion}

The IRF under direct LP is simply the entry of $\Gamma_h$:

\begin{equation}\label{eq:direct_IRF_def}
  \mathrm{IRF}_{i,k}^{\mathrm{Direct}}(h)
  = \frac{\partial y_{i,t+h}}{\partial \varepsilon_t^k}
  = \gamma_{ik}^{(h)}.
\end{equation}

The full $2\times5$ direct IRF matrix at horizon $h$ is:

\begin{equation}\label{eq:direct_IRF_mat}
\mathbf{IRF}^{\mathrm{Direct}}(h)
= \Gamma_h
=
\begin{pmatrix}
  \gamma_{11}^{(h)} & \gamma_{12}^{(h)} & \gamma_{13}^{(h)} & \gamma_{14}^{(h)} & \gamma_{15}^{(h)}\\[6pt]
  \gamma_{21}^{(h)} & \gamma_{22}^{(h)} & \gamma_{23}^{(h)} & \gamma_{24}^{(h)} & \gamma_{25}^{(h)}
\end{pmatrix}
\end{equation}

Written as ten scalar equations (one per outcome-shock pair), the direct LP delivers:

\begin{align}
  \mathrm{IRF}_{\log\mathrm{IP},\,\mathrm{FP}}^{\mathrm{Direct}}(h)   &= \gamma_{11}^{(h)}, &
  \mathrm{IRF}_{u,\,\mathrm{FP}}^{\mathrm{Direct}}(h)   &= \gamma_{21}^{(h)}, \nonumber\\
  \mathrm{IRF}_{\log\mathrm{IP},\,\mathrm{MP}}^{\mathrm{Direct}}(h)   &= \gamma_{12}^{(h)}, &
  \mathrm{IRF}_{u,\,\mathrm{MP}}^{\mathrm{Direct}}(h)   &= \gamma_{22}^{(h)}, \nonumber\\
  \mathrm{IRF}_{\log\mathrm{IP},\,\mathrm{TFP}}^{\mathrm{Direct}}(h)  &= \gamma_{13}^{(h)}, &
  \mathrm{IRF}_{u,\,\mathrm{TFP}}^{\mathrm{Direct}}(h)  &= \gamma_{23}^{(h)}, \label{eq:direct_10}\\
  \mathrm{IRF}_{\log\mathrm{IP},\,\mathrm{Oil}}^{\mathrm{Direct}}(h)  &= \gamma_{14}^{(h)}, &
  \mathrm{IRF}_{u,\,\mathrm{Oil}}^{\mathrm{Direct}}(h)  &= \gamma_{24}^{(h)}, \nonumber\\
  \mathrm{IRF}_{\log\mathrm{IP},\,\mathrm{Crisis}}^{\mathrm{Direct}}(h) &= \gamma_{15}^{(h)}, &
  \mathrm{IRF}_{u,\,\mathrm{Crisis}}^{\mathrm{Direct}}(h) &= \gamma_{25}^{(h)}. \nonumber
\end{align}

\noindent Each of these ten numbers is an \emph{atomic} OLS estimate; none
of them is decomposed further.

